def reversePrint(llist):
    # Create a stack to store the elements of the linked list
    stack = []
    
    # Traverse the linked list and push the data into the stack
    current = llist
    while current is not None:
        stack.append(current.data)
        current = current.next
    
    # Pop elements from the stack and print them (this will reverse the order)
    while stack:
        print(stack.pop())
















